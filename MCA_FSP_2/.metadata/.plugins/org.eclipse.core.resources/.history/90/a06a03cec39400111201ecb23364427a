package com.proj.testapi.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.proj.testapi.entity.Course;
import com.proj.testapi.entity.Role;
import com.proj.testapi.entity.User;
import com.proj.testapi.repository.CourseRepository;

import jakarta.servlet.http.HttpSession;

@RestController
@RequestMapping("/api/courses")
public class CourseController {
	@Autowired
    private CourseRepository courseRepo;

    // ✅ Create Course (ONLY INSTRUCTOR)
	@PostMapping("/create")
	public ResponseEntity<?> createCourse(@RequestBody Course course, HttpSession session) {

	    User user = (User) session.getAttribute("user");

	    if (user == null) {
	        return ResponseEntity.status(HttpStatus.UNAUTHORIZED)
	                .body("Please login first");
	    }

	    if (user.getRole() != Role.INSTRUCTOR) {
	        return ResponseEntity.status(HttpStatus.FORBIDDEN)
	                .body("Only instructors can create courses");
	    }

	    course.setInstructor(user);

	    Course savedCourse = courseRepo.save(course);

	    return ResponseEntity.ok(savedCourse);
	}

    // ✅ Get all courses
    @GetMapping("/all")
    public List<Course> getAllCourses() {
        return courseRepo.findAll();
    }
}

